module main
author 'Kalasin University'
version 2 0 
description 'Robot car answer key, built on the KSU_RoBoESP32 library.'
variables command 

script 50 50 {
whenStarted
comment 'ANSWER KEY
Connect a phone to the RoboCar hotspot,
then open http://192.168.4.1 and hold the phone sideways.

KSU do command handles every command the page can send -
the direction pad and both sliders on the DRIVE tab, and
also the colours, the eight LEDs, the four servos, the raw
motor sliders and the buzzer on the LIGHT and MORE tabs.
That is why this loop is three blocks long.'
KSU_ROBOESP32_start 'RoboCar' 'robocar123'
forever {
  command = (KSU_ROBOESP32_command)
  KSU_ROBOESP32_do command
  waitMillis 10
}
}

script 50 330 {
comment 'THE LONG FORM - not attached, nothing runs it.
This is what KSU do command does internally for the ten
words on the DRIVE tab. Students build this by hand in
Part 2 of the worksheet; keep it here to show the class
that the one block above is not magic.

The other eleven words - ServoB ServoC ServoD Rgb Dim Led
Leds Motor Tone Song Beep - are handled the same way, just
with more numbers. See _KSU_ROBOESP32_do2 in the library.'
}

script 50 560 {
if (command == 'Forward') {
  KSU_ROBOESP32_forward
}
if (command == 'Backward') {
  KSU_ROBOESP32_backward
}
if (command == 'Left') {
  KSU_ROBOESP32_left
}
if (command == 'Right') {
  KSU_ROBOESP32_right
}
if (command == 'Stop') {
  KSU_ROBOESP32_stop
}
if (command == 'Light1') {
  KSU_ROBOESP32_light 'on'
}
if (command == 'Light0') {
  KSU_ROBOESP32_light 'off'
}
if (command == 'Horn') {
  KSU_ROBOESP32_horn
}
if (command == 'Speed') {
  KSU_ROBOESP32_speed (KSU_ROBOESP32_value)
}
if (command == 'Servo') {
  KSU_ROBOESP32_servo 'D4' (KSU_ROBOESP32_value)
}
}

script 620 60 {
comment 'If a motor runs the wrong way, click this block with
different numbers. Use 1 for normal and -1 for reversed.'
}

script 620 180 {
KSU_ROBOESP32_trim -1 -1
}

script 620 250 {
comment 'Report the address to type into the browser.'
}

script 620 340 {
sayIt (KSU_ROBOESP32_ip)
}

script 620 430 {
comment 'DEMO BLOCKS - click any one to run it on its own,
without pressing Start. Handy for showing the class what
the new blocks do before they open the LIGHT and MORE tabs.'
}

script 620 590 {
KSU_ROBOESP32_drive 'forward' 500
}

script 620 660 {
KSU_ROBOESP32_lednum 3 'on'
}

script 620 730 {
KSU_ROBOESP32_rgbraw 'all' 255 0 0
}

script 620 800 {
KSU_ROBOESP32_note 'nt;c' 0 400
}

script 620 870 {
sayIt (KSU_ROBOESP32_button 'D34')
}


module KSU_RoBoESP32 Input
author 'Kalasin University'
version 2 0
depends 'Robo ESP32' WiFi 'HTTP server' Tone
tags robot car wifi esp32 cytron education
choices ksuonoff on off
choices ksumotor M1 M2 both
choices ksudir forward backward left right
choices ksuservo D4 D5 D18 D19
choices ksurgb '0' '1' all
choices ksugpio D16 D17 D21 D22 D25 D26 D32 D33 all
choices ksubutton D34 D35
description 'Drive every part of a Cytron ROBO ESP32 robot car from a phone browser.

The board becomes its own WiFi hotspot and serves a landscape control page with
three tabs. DRIVE has the direction pad, speed slider, servo slider, light
button and horn button. LIGHT has eight RGB colour swatches, a 0/1/all target
selector, a brightness dimmer and eight numbered GPIO LED toggles. MORE has
sliders for all four servos, raw sliders for both motors, buzzer tone/song/beep
buttons, and a live readout of the two onboard buttons. This library now
covers the whole Cytron Robo ESP32 board, plus Tone, reachable either from your
own if-chain or from the single KSU do command auto-pilot block.

Typical program:

  when started
    KSU start web control name (RoboCar) password (robocar123)
    forever
      set (command) to (KSU web command)
      KSU do command (command)
      wait (10) millisecs

Connect a phone to the hotspot and open http://192.168.4.1

Wiring: motors into M1 and M2, servos into D4/D5/D18/D19 as needed. Nothing
else is needed, the RGB LEDs and the buzzer are already on the board.'
variables _ksu_spd _ksu_rev1 _ksu_rev2 _ksu_args _ksu_req _ksu_path

  spec ' ' 'KSU_ROBOESP32_start' 'KSU start web control name _ password _' 'str str' 'RoboCar' 'robocar123'
  spec 'r' 'KSU_ROBOESP32_command' 'KSU web command'
  spec 'r' 'KSU_ROBOESP32_value' 'KSU command value'
  spec 'r' 'KSU_ROBOESP32_valueN' 'KSU command value # _' 'num' 1
  spec ' ' 'KSU_ROBOESP32_do' 'KSU do command _' 'str' ''
  spec 'r' 'KSU_ROBOESP32_ip' 'KSU IP address'
  space
  spec ' ' 'KSU_ROBOESP32_forward' 'KSU forward'
  spec ' ' 'KSU_ROBOESP32_backward' 'KSU backward'
  spec ' ' 'KSU_ROBOESP32_left' 'KSU turn left'
  spec ' ' 'KSU_ROBOESP32_right' 'KSU turn right'
  spec ' ' 'KSU_ROBOESP32_stop' 'KSU stop'
  spec ' ' 'KSU_ROBOESP32_speed' 'KSU set speed _ %' 'num' 70
  spec ' ' 'KSU_ROBOESP32_drive' 'KSU drive _ for _ ms' 'menu.ksudir num' 'forward' 500
  spec ' ' 'KSU_ROBOESP32_steer' 'KSU steer _ (-100 left to 100 right)' 'num' 0
  spec ' ' 'KSU_ROBOESP32_motor' 'KSU set motor _ power _ (-100 to 100)' 'menu.ksumotor num' 'M1' 70
  spec ' ' 'KSU_ROBOESP32_trim' 'KSU set motor trim M1 _ M2 _' 'num num' -1 -1
  space
  spec ' ' 'KSU_ROBOESP32_arm' 'KSU set arm angle _ degrees (0 to 180)' 'num' 90
  spec ' ' 'KSU_ROBOESP32_servo' 'KSU set servo _ to _ degrees (0 to 180)' 'menu.ksuservo num' 'D4' 90
  space
  spec ' ' 'KSU_ROBOESP32_light' 'KSU light _' 'menu.ksuonoff' 'on'
  spec ' ' 'KSU_ROBOESP32_rgb' 'KSU set RGB _ color _' 'menu.ksurgb color' 'all'
  spec ' ' 'KSU_ROBOESP32_rgbraw' 'KSU set RGB _ red _ green _ blue _' 'menu.ksurgb num num num' 'all' 255 240 200
  spec ' ' 'KSU_ROBOESP32_dim' 'KSU change RGB brightness by _ %' 'num' 25
  spec ' ' 'KSU_ROBOESP32_led' 'KSU LED _ _' 'menu.ksugpio menu.ksuonoff' 'D16' 'on'
  spec ' ' 'KSU_ROBOESP32_lednum' 'KSU LED number _ (1 to 8) _' 'num menu.ksuonoff' 1 'on'
  space
  spec ' ' 'KSU_ROBOESP32_horn' 'KSU horn'
  spec ' ' 'KSU_ROBOESP32_beep' 'KSU beep'
  spec ' ' 'KSU_ROBOESP32_tone' 'KSU play tone _ Hz for _ ms' 'num num' 440 300
  spec ' ' 'KSU_ROBOESP32_note' 'KSU play note _ octave _ for _ ms' 'str.tone_NoteName num num' 'nt;c' 0 400
  spec ' ' 'KSU_ROBOESP32_song' 'KSU play Happy Birthday'
  space
  spec 'r' 'KSU_ROBOESP32_button' 'KSU button _ is pressed' 'menu.ksubutton' 'D34'
  spec 'r' 'KSU_ROBOESP32_read' 'KSU read analog pin _' 'auto' ''
  space
  spec ' ' '_KSU_ROBOESP32_sendPage' '_ksu send control page'
  spec ' ' '_KSU_ROBOESP32_status' '_ksu send status'
  spec ' ' '_KSU_ROBOESP32_do2' '_KSU_ROBOESP32_do2 _' 'str' ''
  spec 'r' '_KSU_ROBOESP32_rgbWhich' '_KSU_ROBOESP32_rgbWhich _' 'num' 0
  spec 'r' '_KSU_ROBOESP32_motorName' '_KSU_ROBOESP32_motorName _' 'num' 1
  spec 'r' '_KSU_ROBOESP32_onOff' '_KSU_ROBOESP32_onOff _' 'num' 1
  spec 'r' '_KSU_ROBOESP32_p1' '_KSU_ROBOESP32_p1'
  spec 'r' '_KSU_ROBOESP32_p2' '_KSU_ROBOESP32_p2'
  spec 'r' '_KSU_ROBOESP32_p3' '_KSU_ROBOESP32_p3'
  spec 'r' '_KSU_ROBOESP32_p4' '_KSU_ROBOESP32_p4'
  spec 'r' '_KSU_ROBOESP32_p5' '_KSU_ROBOESP32_p5'
  spec 'r' '_KSU_ROBOESP32_p6' '_KSU_ROBOESP32_p6'
  spec 'r' '_KSU_ROBOESP32_p7' '_KSU_ROBOESP32_p7'
  spec 'r' '_KSU_ROBOESP32_p8' '_KSU_ROBOESP32_p8'

to KSU_ROBOESP32_start ssid password {
  comment 'Start the hotspot and the web server.
The password must be at least 8 characters.
Speed starts at 70 percent, all four servos centre at 90
degrees, and both motors start trimmed to -1, which suits a
car with the motors mounted facing each other. Use the motor
trim block to change that.'
  _ksu_spd = 70
  _ksu_args = ('[data:makeList]' 90)
  _ksu_rev1 = -1
  _ksu_rev2 = -1
  KSU_ROBOESP32_stop
  roboESP32_clear_RGB
  'attach buzzer to pin' 23
  KSU_ROBOESP32_servo 'D4' 90
  KSU_ROBOESP32_servo 'D5' 90
  KSU_ROBOESP32_servo 'D18' 90
  KSU_ROBOESP32_servo 'D19' 90
  wifiCreateHotspot ssid password
  roboESP32_set_RGB 'all' (colorFromRGB 0 40 20)
}

to KSU_ROBOESP32_command {
  comment 'Report the word sent by the control page, or empty text when
nothing has arrived yet. Serving the page, answering a status
poll, and splitting off any numbers that came with the command
all happen in here - a program only ever sees a plain word such
as Forward or Rgb. Read any numbers with KSU command value or
KSU command value #.'
  _ksu_req = ('[net:httpServerGetRequest]')
  if (_ksu_req == '') {
    return ''
  }
  _ksu_path = ('[data:copyFromTo]' ('path of request' _ksu_req) 2)
  if (_ksu_path == '') {
    _KSU_ROBOESP32_sendPage
    return ''
  }
  if (_ksu_path == 'Status') {
    _KSU_ROBOESP32_status
    return ''
  }
  '[net:respondToHttpRequest]' '200 OK' 'ok'
  local 'i' ('[data:find]' '_' _ksu_path)
  if (i < 1) {
    _ksu_args = ('[data:makeList]')
    return _ksu_path
  }
  local 'word' ('[data:copyFromTo]' _ksu_path 1 (i - 1))
  _ksu_args = ('[data:makeList]')
  local 'start' (i + 1)
  local 'stop' 0
  repeatUntil (start > (size _ksu_path)) {
    stop = ('[data:find]' '_' _ksu_path start)
    if (stop < 1) {
      stop = ((size _ksu_path) + 1)
    }
    '[data:addLast]' (('[data:copyFromTo]' _ksu_path start (stop - 1)) + 0) _ksu_args
    start = (stop + 1)
  }
  return word
}

to KSU_ROBOESP32_value {
  comment 'Report the first number that came with the last command, or
90 (the middle servo angle) when the last command carried no
number at all - for example after Forward or Stop.'
  if ((size _ksu_args) < 1) {
    return 90
  }
  return (at 1 _ksu_args)
}

to KSU_ROBOESP32_valueN i {
  comment 'Report the i-th number that came with the last command
(1 is the first one), or 0 if there is no such number.'
  if (or (i < 1) (i > (size _ksu_args))) {
    return 0
  }
  return (at i _ksu_args)
}

to KSU_ROBOESP32_do word {
  comment 'The auto-pilot block. Call it once per loop with the word
from KSU web command and it does everything the page can ask
for, including reading back any numbers that came with it. Put
this one block in your forever loop instead of a long if-chain.'
  if (word == 'Forward') {
    KSU_ROBOESP32_forward
  } (word == 'Backward') {
    KSU_ROBOESP32_backward
  } (word == 'Left') {
    KSU_ROBOESP32_left
  } (word == 'Right') {
    KSU_ROBOESP32_right
  } (word == 'Stop') {
    KSU_ROBOESP32_stop
  } (word == 'Light1') {
    KSU_ROBOESP32_light 'on'
  } (word == 'Light0') {
    KSU_ROBOESP32_light 'off'
  } (word == 'Horn') {
    KSU_ROBOESP32_horn
  } (word == 'Speed') {
    KSU_ROBOESP32_speed (KSU_ROBOESP32_value)
  } (word == 'Servo') {
    KSU_ROBOESP32_servo 'D4' (KSU_ROBOESP32_value)
  } else {
    _KSU_ROBOESP32_do2 word
  }
}

to KSU_ROBOESP32_ip {
  return ('[net:myIPAddress]')
}

to KSU_ROBOESP32_forward {
  roboESP32_set_motor 'M1' (_ksu_spd * _ksu_rev1)
  roboESP32_set_motor 'M2' (_ksu_spd * _ksu_rev2)
}

to KSU_ROBOESP32_backward {
  roboESP32_set_motor 'M1' (0 - (_ksu_spd * _ksu_rev1))
  roboESP32_set_motor 'M2' (0 - (_ksu_spd * _ksu_rev2))
}

to KSU_ROBOESP32_left {
  roboESP32_set_motor 'M1' (0 - (_ksu_spd * _ksu_rev1))
  roboESP32_set_motor 'M2' (_ksu_spd * _ksu_rev2)
}

to KSU_ROBOESP32_right {
  roboESP32_set_motor 'M1' (_ksu_spd * _ksu_rev1)
  roboESP32_set_motor 'M2' (0 - (_ksu_spd * _ksu_rev2))
}

to KSU_ROBOESP32_stop {
  roboESP32_stop_motor 'both'
}

to KSU_ROBOESP32_speed n {
  _ksu_spd = n
}

to KSU_ROBOESP32_drive dir ms {
  comment 'Run one of the four directions for _ milliseconds, then stop.'
  if (dir == 'forward') {
    KSU_ROBOESP32_forward
  } (dir == 'backward') {
    KSU_ROBOESP32_backward
  } (dir == 'left') {
    KSU_ROBOESP32_left
  } (dir == 'right') {
    KSU_ROBOESP32_right
  }
  waitMillis ms
  KSU_ROBOESP32_stop
}

to KSU_ROBOESP32_steer s {
  comment '-100 spins in place to the left, 0 drives straight, 100
spins in place to the right. The wheel on the inside of the
turn slows down (and can reverse); the outside wheel keeps
going at the current set speed.

The multiply happens before the divide on purpose. This board
does whole-number arithmetic, so dividing first would throw
away every steering value smaller than 50.'
  local 'inner' (maximum -100 (minimum 100 ((_ksu_spd * (50 - (absoluteValue s))) / 50)))
  if (s < 0) {
    roboESP32_set_motor 'M1' (inner * _ksu_rev1)
    roboESP32_set_motor 'M2' (_ksu_spd * _ksu_rev2)
  } else {
    roboESP32_set_motor 'M1' (_ksu_spd * _ksu_rev1)
    roboESP32_set_motor 'M2' (inner * _ksu_rev2)
  }
}

to KSU_ROBOESP32_motor which power {
  comment 'Raw single-motor control, -100 to 100. The motor trim is
still applied, so this matches the direction of Forward /
Backward for whichever wheel you pick.'
  if (which == 'M1') {
    roboESP32_set_motor 'M1' (power * _ksu_rev1)
  } (which == 'M2') {
    roboESP32_set_motor 'M2' (power * _ksu_rev2)
  } else {
    roboESP32_set_motor 'M1' (power * _ksu_rev1)
    roboESP32_set_motor 'M2' (power * _ksu_rev2)
  }
}

to KSU_ROBOESP32_trim m1 m2 {
  comment 'Use 1 for a motor that runs the right way and -1 for one
that is wired backwards.

  car drives backwards and turns the wrong way -> both -1
  car spins instead of driving forward -> flip only one of them'
  _ksu_rev1 = m1
  _ksu_rev2 = m2
}

to KSU_ROBOESP32_arm deg {
  comment 'The arm servo plugs into header D4. Same as
KSU set servo (D4) to (deg) degrees.'
  KSU_ROBOESP32_servo 'D4' deg
}

to KSU_ROBOESP32_servo pin deg {
  comment 'pin is D4, D5, D18 or D19. The page and this block both
use 0 to 180; the Cytron board itself wants -90 to 90, so this
converts once here.'
  roboESP32_set_servo pin (deg - 90)
}

to KSU_ROBOESP32_light state {
  if (state == 'on') {
    roboESP32_set_RGB 'all' (colorFromRGB 255 240 200)
  } else {
    roboESP32_clear_RGB
  }
}

to KSU_ROBOESP32_rgb which color {
  roboESP32_set_RGB which color
}

to KSU_ROBOESP32_rgbraw which r g b {
  roboESP32_set_RGB which (colorFromRGB r g b)
}

to KSU_ROBOESP32_dim delta {
  comment 'Positive numbers brighten the RGB LEDs, negative numbers
dim them.'
  'roboESP32_increase_RGB _brightness' delta
}

to KSU_ROBOESP32_led pin state {
  comment 'One GPIO LED (D16 D17 D21 D22 D25 D26 D32 D33), or all
eight at once if you pick all.'
  roboESP32_set_GPIO pin (state == 'on')
}

to KSU_ROBOESP32_lednum i onOff {
  comment 'LED number 1 to 8, in the order printed on the board:
D16 D17 D21 D22 D25 D26 D32 D33.
Numbers outside 1 to 8 are ignored rather than stopping the
program, so a mistyped address in the browser is harmless.'
  if (and (i >= 1) (i <= 8)) {
    digitalWriteOp (at i ('[data:makeList]' 16 17 21 22 25 26 32 33)) (onOff == 'on')
  }
}

to KSU_ROBOESP32_horn {
  'play frequency' 700 120
  'play frequency' 520 180
}

to KSU_ROBOESP32_beep {
  'play frequency' 880 60
}

to KSU_ROBOESP32_tone hz ms {
  'play frequency' hz ms
}

to KSU_ROBOESP32_note note octave ms {
  'play tone' note octave ms
}

to KSU_ROBOESP32_song {
  roboESP32_play_song
}

to KSU_ROBOESP32_button pin {
  return (roboESP32_button pin)
}

to KSU_ROBOESP32_read pin {
  comment 'Read an analog value on a Grove or expansion pin - give
the GPIO number printed on the board, for example 34.'
  return (analogReadOp pin)
}

to _KSU_ROBOESP32_sendPage {
  comment 'The page is stored in several small blocks because one
MicroBlocks script cannot compile to more than 1000 bytes.'
  '[net:respondToHttpRequest]' '200 OK' ('[data:join]' (_KSU_ROBOESP32_p1) (_KSU_ROBOESP32_p2) (_KSU_ROBOESP32_p3) (_KSU_ROBOESP32_p4) (_KSU_ROBOESP32_p5) (_KSU_ROBOESP32_p6) (_KSU_ROBOESP32_p7) (_KSU_ROBOESP32_p8)) 'Content-Type: text/html'
}

to _KSU_ROBOESP32_status {
  comment 'Answer a /Status poll from the MORE tab without ever handing
the word to the student program. Body is plain text
b1,b2,speed,value - for example 1,0,70,90 - where b1/b2 are the
two onboard buttons (1 = pressed) and value is whatever KSU
command value would currently report.'
  local 'b1' '0'
  local 'b2' '0'
  if (roboESP32_button 'D34') {
    b1 = '1'
  }
  if (roboESP32_button 'D35') {
    b2 = '1'
  }
  '[net:respondToHttpRequest]' '200 OK' ('[data:join]' b1 ',' b2 ',' _ksu_spd ',' (KSU_ROBOESP32_value)) 'Content-Type: text/plain'
}

to _KSU_ROBOESP32_do2 word {
  comment 'Second half of the auto-pilot word list - called from KSU
do command so that block stays under the 1000 byte compiled
script limit. Never call this one directly.'
  if (word == 'ServoB') {
    KSU_ROBOESP32_servo 'D5' (KSU_ROBOESP32_value)
  } (word == 'ServoC') {
    KSU_ROBOESP32_servo 'D18' (KSU_ROBOESP32_value)
  } (word == 'ServoD') {
    KSU_ROBOESP32_servo 'D19' (KSU_ROBOESP32_value)
  } (word == 'Rgb') {
    KSU_ROBOESP32_rgbraw (_KSU_ROBOESP32_rgbWhich (KSU_ROBOESP32_valueN 1)) (KSU_ROBOESP32_valueN 2) (KSU_ROBOESP32_valueN 3) (KSU_ROBOESP32_valueN 4)
  } (word == 'Dim') {
    KSU_ROBOESP32_dim (KSU_ROBOESP32_value)
  } (word == 'Led') {
    KSU_ROBOESP32_lednum (KSU_ROBOESP32_valueN 1) (_KSU_ROBOESP32_onOff (KSU_ROBOESP32_valueN 2))
  } (word == 'Leds') {
    KSU_ROBOESP32_led 'all' (_KSU_ROBOESP32_onOff (KSU_ROBOESP32_value))
  } (word == 'Motor') {
    KSU_ROBOESP32_motor (_KSU_ROBOESP32_motorName (KSU_ROBOESP32_valueN 1)) (KSU_ROBOESP32_valueN 2)
  } (word == 'Tone') {
    KSU_ROBOESP32_tone (KSU_ROBOESP32_valueN 1) (KSU_ROBOESP32_valueN 2)
  } (word == 'Song') {
    KSU_ROBOESP32_song
  } (word == 'Beep') {
    KSU_ROBOESP32_beep
  }
}

to _KSU_ROBOESP32_rgbWhich n {
  comment 'Convert the pages numeric RGB target (0, 1 or 2) into the
menu value the Robo ESP32 blocks expect (0, 1 or all).'
  if (n == 2) {
    return 'all'
  } (n == 1) {
    return '1'
  } else {
    return '0'
  }
}

to _KSU_ROBOESP32_motorName n {
  comment 'Convert the pages numeric motor number (1 or 2) into the
menu value the Robo ESP32 blocks expect (M1 or M2).'
  if (n == 2) {
    return 'M2'
  } else {
    return 'M1'
  }
}

to _KSU_ROBOESP32_onOff n {
  comment 'Convert a 1/0 from the page into on/off for the light
blocks.'
  if (n == 1) {
    return 'on'
  } else {
    return 'off'
  }
}

to _KSU_ROBOESP32_p1 {
  return '<!doctype html><meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no"><style>*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{height:100%}body{margin:0;font:16px system-ui;background:#0e1116;color:#e6edf3;text-align:center;overflow:hidden}#w{display:flex;flex-direction:column;height:100dvh;padding:10px;gap:8px}.z{flex:1;display:none;overflow-y:auto}.z.y{display:flex;gap:12px}#li,#mo{flex-direction:column}#p{flex:1.1;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);gap:8px}#F{grid-area:1/2}#L{grid-area:2/1}#S{grid-area:2/2}#R{grid-area:2/3}#B{grid-area:3/2}#g{flex:1;display:flex;flex-direction:column;'
}

to _KSU_ROBOESP32_p2 {
